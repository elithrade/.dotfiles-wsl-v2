#!/usr/bin/env bash

# Usage: ./install [--update] [dotbot options...]
#
# --update also upgrades tools that are already installed (they are skipped otherwise).
# Steps read it from DOTFILES_UPDATE.

set -e

CONFIG="install.conf.yaml"
DOTBOT_DIR="dotbot"

DOTBOT_BIN="bin/dotbot"
BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

ARGS=()
for arg in "$@"; do
  if [ "${arg}" = "--update" ]; then
    export DOTFILES_UPDATE=1
  else
    ARGS+=("${arg}")
  fi
done

cd "${BASEDIR}"
git -C "${DOTBOT_DIR}" submodule sync --quiet --recursive
git submodule update --init --recursive "${DOTBOT_DIR}"

"${BASEDIR}/${DOTBOT_DIR}/${DOTBOT_BIN}" -d "${BASEDIR}" -c "${CONFIG}" "${ARGS[@]}"
